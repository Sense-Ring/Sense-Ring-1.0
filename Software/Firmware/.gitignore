# Zephyr/west build output. Regenerated by `build_env.bat`, and it bakes in
# absolute paths from whichever machine built it.
build/
build-*/
.west/
twister-out*/

# Host test binaries: `cd tests/host && make all` rebuilds these in a second.
tests/host/build/

# Bench captures -- RTT dumps off the ring, adb logcat off the phone. These are
# session evidence tied to one board on one desk, not something the repo carries.
*.log
.rtt_logs/

# Editor and OS noise
*.swp
*~
.DS_Store
Thumbs.db

# Local agent/editor state: machine-specific paths, not project config.
.claude/settings.local.json
